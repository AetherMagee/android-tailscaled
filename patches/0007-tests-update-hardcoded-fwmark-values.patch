-		"--ctmask", "0xff0000",
+		"--nfmask", "0x60000000",
+		"--ctmask", "0x60000000",
 	}
 
 	outputArgs := []string{
 		"-m", "conntrack",
 		"--ctstate", "NEW",
 		"-m", "mark",
-		"!", "--mark", "0x0/0xff0000",
+		"!", "--mark", "0x0/0x60000000",
 		"-j", "CONNMARK",
 		"--save-mark",
-		"--nfmask", "0xff0000",
-		"--ctmask", "0xff0000",
+		"--nfmask", "0x60000000",
+		"--ctmask", "0x60000000",
 	}
 
 	t.Run("with_ipv6", func(t *testing.T) {
